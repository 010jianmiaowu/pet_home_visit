.container {
  min-height: 100vh;
  background-color: #FFF9F2;
}

.profile-header {
  background: #fff;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.user-info {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
}

.avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: 4rpx solid #C4A77D;
}

.info-text {
  flex: 1;
  margin-left: 24rpx;
}

.username {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  display: block;
}

.id {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.stats {
  display: flex;
  justify-content: center;
  margin-bottom: 28rpx;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.stat-divider {
  width: 1rpx;
  background: rgba(0,0,0,0.1);
}

.bio {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 28rpx;
  white-space: pre-wrap;
}

.quick-actions {
  display: flex;
  gap: 20rpx;
}

.action-card {
  flex: 1;
  background: #FFF9F2;
  border-radius: 20rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.action-icon {
  font-size: 40rpx;
}

.action-label {
  flex: 1;
  font-size: 26rpx;
  color: #333;
}

.action-count {
  font-size: 24rpx;
  color: #999;
}

.content-tabs {
  display: flex;
  justify-content: space-around;
  background: #fff;
  padding: 20rpx 0;
  margin-bottom: 16rpx;
}

.tab-item {
  font-size: 28rpx;
  color: #999;
  padding: 8rpx 32rpx;
}

.tab-item.active {
  color: #C4A77D;
  font-weight: 500;
  border-bottom: 4rpx solid #C4A77D;
}

.posts-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 16rpx;
}

.post-item {
  width: calc(33.33% - 12rpx);
  margin: 6rpx;
  position: relative;
  aspect-ratio: 1;
}

.post-image {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.post-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx;
  background: rgba(0,0,0,0.3);
  border-radius: 0 0 12rpx 12rpx;
}

.overlay-icon {
  font-size: 24rpx;
}

.overlay-count {
  font-size: 22rpx;
  color: #fff;
}