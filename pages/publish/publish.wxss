.container {
  min-height: 100vh;
  background-color: #FFF9F2;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 32rpx;
  background-color: #FFF9F2;
}

.back-btn, .next-btn {
  padding: 12rpx 24rpx;
}

.back-btn text {
  font-size: 30rpx;
  color: #666;
}

.next-btn text {
  font-size: 30rpx;
  color: #C4A77D;
  font-weight: 500;
}

.title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
}

.content {
  padding: 24rpx;
}

.upload-area {
  background: #fff;
  border-radius: 24rpx;
  padding: 64rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  border: 2rpx dashed #DDD;
  margin-bottom: 24rpx;
}

.upload-icon {
  width: 120rpx;
  height: 120rpx;
  background: rgba(196, 167, 125, 0.1);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}

.upload-icon .plus {
  font-size: 64rpx;
  color: #C4A77D;
}

.upload-text {
  font-size: 30rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.upload-hint {
  font-size: 24rpx;
  color: #999;
}

.input-area {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.content-input {
  width: 100%;
  min-height: 200rpx;
  font-size: 30rpx;
  color: #333;
  line-height: 1.6;
}

.char-count {
  display: block;
  text-align: right;
  font-size: 24rpx;
  color: #999;
  margin-top: 12rpx;
}

.tags-area {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.tag-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 24rpx;
  background: #fff;
  border-radius: 32rpx;
}

.tag-icon {
  font-size: 28rpx;
}

.tag-text {
  font-size: 26rpx;
  color: #666;
}

.settings-area {
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
}

.setting-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid rgba(0,0,0,0.05);
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-label {
  font-size: 28rpx;
  color: #333;
}

.setting-value {
  font-size: 28rpx;
  color: #999;
}

.arrow {
  font-size: 32rpx;
  color: #999;
}

.setting-switch {
  transform: scale(0.8);
}