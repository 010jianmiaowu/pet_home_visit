.container {
  min-height: 100vh;
  background-color: #FFF9F2;
  padding-bottom: 120rpx;
}

.post-detail {
  background: #fff;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.post-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
}

.user-info {
  flex: 1;
  margin-left: 16rpx;
}

.username {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
}

.time {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.follow-btn {
  padding: 12rpx 32rpx;
  background: #C4A77D;
  border-radius: 32rpx;
}

.follow-btn text {
  font-size: 24rpx;
  color: #fff;
}

.post-content {
  font-size: 30rpx;
  color: #333;
  line-height: 1.8;
  margin-bottom: 20rpx;
  white-space: pre-wrap;
}

.post-image {
  width: 100%;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
}

.post-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.tag {
  font-size: 22rpx;
  color: #C4A77D;
  background: rgba(196, 167, 125, 0.1);
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.post-actions {
  display: flex;
  gap: 64rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(0,0,0,0.05);
}

.action-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.action-icon {
  font-size: 36rpx;
}

.action-text {
  font-size: 26rpx;
  color: #666;
}

.comments-section {
  background: #fff;
  padding: 24rpx;
}

.section-header {
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
}

.comment-item {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(0,0,0,0.05);
}

.comment-item:last-child {
  border-bottom: none;
}

.comment-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
}

.comment-content {
  flex: 1;
  margin-left: 16rpx;
}

.comment-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.comment-username {
  font-size: 26rpx;
  font-weight: 500;
  color: #333;
}

.comment-time {
  font-size: 22rpx;
  color: #999;
}

.comment-text {
  font-size: 26rpx;
  color: #333;
  line-height: 1.6;
}

.comment-action {
  margin-top: 12rpx;
}

.comment-like {
  font-size: 24rpx;
  color: #999;
}

.comment-input-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  background: #fff;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid rgba(0,0,0,0.05);
  gap: 16rpx;
}

.comment-input {
  flex: 1;
  height: 72rpx;
  background: rgba(0,0,0,0.05);
  border-radius: 36rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
}

.send-btn {
  padding: 16rpx 32rpx;
  background: #C4A77D;
  border-radius: 36rpx;
}

.send-btn text {
  font-size: 28rpx;
  color: #fff;
}