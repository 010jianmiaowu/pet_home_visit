<view class="container">
  <view class="profile-section">
    <view class="profile-card" bindtap="goToProfile">
      <image class="avatar" src="{{user.avatar}}" mode="aspectFill" />
      <view class="profile-info">
        <text class="username">{{user.username}}</text>
        <text class="id">ID: {{user.idNumber}}</text>
      </view>
      <text class="arrow">›</text>
    </view>
  </view>
  
  <view class="pets-section">
    <view class="section-header">
      <text class="section-title">我的宠物档案</text>
    </view>
    
    <view wx:for="{{pets}}" wx:key="id" class="pet-card">
      <image class="pet-avatar" src="{{item.avatar}}" mode="aspectFill" />
      <view class="pet-info">
        <view class="pet-name-row">
          <text class="pet-name">{{item.name}}</text>
          <text class="pet-gender">{{item.gender}}</text>
        </view>
        <text class="pet-type">{{item.type}} | {{item.age}}</text>
      </view>
      <text class="arrow">›</text>
    </view>
    
    <view class="add-pet-btn" bindtap="addPet">
      <text class="add-icon">+</text>
      <text class="add-text">添加宠物</text>
    </view>
  </view>
  
  <view class="menu-section">
    <view class="menu-item">
      <text class="menu-icon">⚙️</text>
      <text class="menu-text">设置</text>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item">
      <text class="menu-icon">💬</text>
      <text class="menu-text">意见反馈</text>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item">
      <text class="menu-icon">❓</text>
      <text class="menu-text">帮助与客服</text>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item">
      <text class="menu-icon">ℹ️</text>
      <text class="menu-text">关于我们</text>
      <text class="arrow">›</text>
    </view>
  </view>
  
  <view class="version-info">
    <text class="version-text">萌宠日记 v1.0.0</text>
  </view>
</view>