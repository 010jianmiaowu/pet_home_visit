.container {
  min-height: 100vh;
  background-color: #FFF9F2;
  padding-bottom: 120rpx;
}

.profile-section {
  padding: 32rpx;
}

.profile-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  display: flex;
  align-items: center;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid #C4A77D;
}

.profile-info {
  flex: 1;
  margin-left: 24rpx;
}

.username {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  display: block;
}

.id {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.arrow {
  font-size: 36rpx;
  color: #999;
}

.pets-section {
  padding: 0 32rpx;
  margin-bottom: 24rpx;
}

.section-header {
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.pet-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.pet-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
}

.pet-info {
  flex: 1;
  margin-left: 20rpx;
}

.pet-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.pet-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
}

.pet-gender {
  font-size: 22rpx;
  color: #C4A77D;
  background: rgba(196, 167, 125, 0.1);
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

.pet-type {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.add-pet-btn {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  border: 2rpx dashed #DDD;
}

.add-icon {
  font-size: 36rpx;
  color: #C4A77D;
}

.add-text {
  font-size: 28rpx;
  color: #999;
}

.menu-section {
  background: #fff;
  border-radius: 24rpx;
  margin: 0 32rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid rgba(0,0,0,0.05);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.menu-text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.version-info {
  text-align: center;
  padding: 48rpx 0;
}

.version-text {
  font-size: 24rpx;
  color: #999;
}